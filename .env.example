APP_NAME="REGC Fleet Management & Shipment Tracking"
APP_ENV=production
APP_URL=https://your-domain.infinityfreeapp.com
APP_TIMEZONE=Asia/Manila

# Database Configuration (For InfinityFree, obtain these from vPanel -> MySQL Databases)
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_regclms
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=your_vpanel_password

# ── Mail / SMTP Configuration ──────────────────────────────────────────
# For Gmail: host=smtp.gmail.com  port=587  encryption=tls
# Use a Gmail "App Password" (requires 2-Step Verification enabled)
# See: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME="REGC Fleet Management"

# ── SMS / Text Message Configuration ───────────────────────────────────
# Provider: Semaphore (Philippine SMS gateway)
# Sign up FREE at https://semaphore.co — 1,000 SMS/month free tier
# SMS_SENDER_NAME: max 11 chars, no spaces
SMS_PROVIDER=semaphore
SMS_API_KEY=your-semaphore-api-key
SMS_SENDER_NAME=REGCLMS
